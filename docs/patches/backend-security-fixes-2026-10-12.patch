@@ -0,0 +1,29 @@
+"""Append-only audit log for privileged admin/operator actions — who did what,
+to what, and when. Sibling of celo_audit.py / stellar_audit.py /
+fiat_payout_audit.py, which record what was *signed on a chain or sent to a
+payout rail*; this one records the *human decision* behind it (kill switch
+flipped, spread changed, revenue cashed out, sandbox reset, ...), so an
+incident review can answer "who changed that" and not just "what moved".
+
+Never raises: an audit-write failure must not block the admin action itself,
+but it is a visibility gap worth alerting on separately.
+"""
+import uuid
+from datetime import datetime
+
+
+async def log_admin_action(db, current_user: dict | None, action: str, **fields) -> dict:
+    doc = {
+        "_id": f"ADMIN_{uuid.uuid4().hex[:12].upper()}",
+        "action": action,
+        "actorId": str((current_user or {}).get("_id") or ""),
+        "actorEmail": (current_user or {}).get("email"),
+        "actorRole": (current_user or {}).get("role"),
+        "createdAt": datetime.utcnow(),
+        **fields,
+    }
+    try:
+        await db["admin_audit_log"].insert_one(doc)
+    except Exception:
+        pass
+    return doc
diff --git a/request_lock.py b/request_lock.py
new file mode 100644
index 0000000..cb07889
--- /dev/null
+++ b/request_lock.py
@@ -0,0 +1,82 @@
+"""Per-user, per-operation mutual exclusion backed by MongoDB.
+
+Why: /ramp/execute, withdrawals and transfers read a balance, call a provider
+or a chain, then write results -- none of it inside a database transaction. Two
+overlapping requests from one user (a double-click, a retry on a slow
+connection, a scripted burst) both pass the balance check and both execute.
+Holding this lock for the duration of the request makes the second one fail
+fast with 429 instead of racing the first.
+
+A MongoDB document (not an in-process asyncio.Lock) so it also holds across
+multiple workers/instances. A lock that is never released (process killed
+mid-request) expires after `ttl_seconds` and can then be taken over.
+"""
+import uuid
+from datetime import datetime, timedelta
+
+from fastapi import HTTPException
+from pymongo.errors import DuplicateKeyError
+
+_COLLECTION = "request_locks"
+
+
+async def acquire_user_lock(db, user_id, name: str, ttl_seconds: int = 300) -> str:
+    """Take the lock or raise HTTP 429. Returns a token to pass to release."""
+    lock_id = f"{name}:{user_id}"
+    token = uuid.uuid4().hex
+    now = datetime.utcnow()
+    doc = {"_id": lock_id, "token": token, "acquiredAt": now, "expiresAt": now + timedelta(seconds=ttl_seconds)}
+    try:
+        await db[_COLLECTION].insert_one(doc)
+        return token
+    except DuplicateKeyError:
+        pass
+
+    # Someone holds it. Take over only if their lock has expired (crashed holder).
+    taken = await db[_COLLECTION].find_one_and_update(
+        {"_id": lock_id, "expiresAt": {"$lt": now}},
+        {"$set": {k: v for k, v in doc.items() if k != "_id"}},
+    )
+    if taken:
+        return token
+    raise HTTPException(
+        status_code=429,
+        detail="Another transaction on your account is still in progress. Please wait a moment and try again.",
+    )
+
+
+async def release_user_lock(db, user_id, name: str, token: str) -> None:
+    """Release only if we still own it (token match). Never raises."""
+    try:
+        await db[_COLLECTION].delete_one({"_id": f"{name}:{user_id}", "token": token})
+    except Exception:
+        pass
+
+
+# ---------------------------------------------------------------------------
+# FastAPI dependency: one money-moving request per user at a time
+# ---------------------------------------------------------------------------
+# Imported lazily inside the function so this module stays importable without
+# routes.auth (and so there can never be an import cycle with it).
+MONEY_OUT = "money_out"
+
+
+def single_flight(name: str = MONEY_OUT):
+    """Use as `@router.post(..., dependencies=[Depends(single_flight())])`.
+
+    Every route that moves value out of a user's balance shares the same lock
+    name by default, so a user also can't run a withdrawal, a transfer and a swap
+    in parallel to get several requests past the same balance check."""
+    from fastapi import Depends
+    from database import get_db
+    from routes.auth import get_current_user
+
+    async def _dep(db=Depends(get_db), current_user=Depends(get_current_user)):
+        user_key = str(current_user["_id"])
+        token = await acquire_user_lock(db, user_key, name)
+        try:
+            yield
+        finally:
+            await release_user_lock(db, user_key, name, token)
+
+    return _dep
diff --git a/rate_limit.py b/rate_limit.py
new file mode 100644
index 0000000..55e62e2
--- /dev/null
+++ b/rate_limit.py
@@ -0,0 +1,76 @@
+"""Small in-process sliding-window rate limiter, usable as a FastAPI dependency.
+
+    @router.post("/login/request-otp", dependencies=[Depends(rate_limit("login_otp", 10, 300))])
+
+There was no rate limiting anywhere in the API: password guessing, OTP
+guessing/flooding (each OTP request sends an email), password-reset spam and
+account enumeration through /retail/transfer/lookup were all unbounded.
+
+Scope and limits (be honest about them):
+  * State is per process. With N worker processes the effective limit is N times
+    higher, and a restart clears it. That still stops scripted bursts, which is
+    what matters here; for a multi-instance deployment move the counters to
+    Redis (same interface).
+  * Keyed by client IP, or by user id for authenticated routes (`by="user"`).
+    Behind a proxy the client IP is the RIGHT-most X-Forwarded-For entry (the one
+    the platform's own proxy appended); entries to its left are client-supplied
+    and spoofable, so they are ignored.
+
+Set RATE_LIMIT_DISABLED=true to switch it off (local load tests).
+"""
+import os
+import time
+from collections import defaultdict, deque
+
+from fastapi import HTTPException, Request
+
+_hits: dict[tuple[str, str], deque] = defaultdict(deque)
+_MAX_KEYS = 50_000
+
+
+def client_ip(request: Request) -> str:
+    forwarded = request.headers.get("x-forwarded-for", "")
+    if forwarded:
+        last = forwarded.split(",")[-1].strip()
+        if last:
+            return last
+    return request.client.host if request.client else "unknown"
+
+
+def _check(name: str, key: str, limit: int, window_seconds: int) -> None:
+    if os.getenv("RATE_LIMIT_DISABLED", "false").strip().lower() == "true":
+        return
+    now = time.monotonic()
+    bucket = _hits[(name, key)]
+    while bucket and now - bucket[0] > window_seconds:
+        bucket.popleft()
+    if len(bucket) >= limit:
+        retry_after = max(1, int(window_seconds - (now - bucket[0])))
+        raise HTTPException(
+            status_code=429,
+            detail="Too many requests. Please wait a moment and try again.",
+            headers={"Retry-After": str(retry_after)},
+        )
+    bucket.append(now)
+
+    # Bound memory: drop empty/old buckets if the table grows large.
+    if len(_hits) > _MAX_KEYS:
+        for k in [k for k, v in _hits.items() if not v or now - v[-1] > window_seconds]:
+            _hits.pop(k, None)
+
+
+def rate_limit(name: str, limit: int, window_seconds: int):
+    """Dependency factory: at most `limit` calls per `window_seconds` per client IP."""
+    async def _dep(request: Request):
+        _check(name, client_ip(request), limit, window_seconds)
+    return _dep
+
+
+def rate_limit_user(name: str, limit: int, window_seconds: int):
+    """Same, keyed by the authenticated user id (falls back to IP)."""
+    from fastapi import Depends
+    from routes.auth import get_current_user
+
+    async def _dep(request: Request, current_user=Depends(get_current_user)):
+        _check(name, str((current_user or {}).get("_id") or client_ip(request)), limit, window_seconds)
+    return _dep
diff --git a/celo_nonce.py b/celo_nonce.py
new file mode 100644
index 0000000..3012033
--- /dev/null
+++ b/celo_nonce.py
@@ -0,0 +1,43 @@
+"""Collision-free nonces for transactions signed with the shared Celo treasury key.
+
+Four independent code paths sign with the SAME treasury key -- customer
+withdrawals (routes/valora.py), swap settlement (routes/swap_engine.py), deposit
+gas top-ups (workers/celo_deposit_watcher.py) and the corridor exit
+(Brain_Engine/celo_integrations.py). Each used `get_transaction_count(addr)`,
+which counts only MINED transactions. Two of them signing within the same block
+interval received the same nonce: one transaction replaced the other or was
+rejected ("nonce too low" / "replacement underpriced"), surfacing as a random
+failed withdrawal or a swap whose on-chain leg silently never happened.
+
+reserve_treasury_nonce():
+  * asks the node for the PENDING count (includes unmined txs the node knows about);
+  * never returns a nonce at or below one this process already handed out in the
+    last NONCE_CACHE_SECONDS, which covers the window before the node has seen
+    our previous broadcast;
+  * is serialised by a lock, so concurrent threads/requests get distinct values.
+
+The cache expires so that a nonce reserved but never broadcast (build/sign error)
+cannot leave a permanent gap: after the window the node's pending count is used
+again and the gap is filled.
+
+Limit: this protects ONE process. Running several API instances against the same
+treasury key needs a shared signer (a queue/service) instead.
+"""
+import threading
+import time
+
+NONCE_CACHE_SECONDS = 120
+
+_lock = threading.Lock()
+_last: dict[str, tuple[int, float]] = {}
+
+
+def reserve_treasury_nonce(w3, address: str) -> int:
+    with _lock:
+        chain_pending = w3.eth.get_transaction_count(address, "pending")
+        nonce = chain_pending
+        cached = _last.get(address)
+        if cached and (time.monotonic() - cached[1]) < NONCE_CACHE_SECONDS:
+            nonce = max(chain_pending, cached[0] + 1)
+        _last[address] = (nonce, time.monotonic())
+        return nonce
diff --git a/routes/admin_audit_view.py b/routes/admin_audit_view.py
new file mode 100644
index 0000000..de8587c
--- /dev/null
+++ b/routes/admin_audit_view.py
@@ -0,0 +1,147 @@
+"""Admin-only read access to the platform's audit trails and "stuck money" queue.
+
+Before this existed the audit collections (celo_audit_log, stellar_audit_log,
+fiat_payout_audit_log, compliance_checks, airtel_callback_events,
+internal_transfers) could only be read by querying MongoDB directly, internal
+transfers did not appear in the admin dashboard at all, and nothing surfaced a
+request that died halfway (debited but never credited/refunded).
+
+  GET /api/admin/audit/events   one feed per source, newest first, with search + paging
+  GET /api/admin/audit/stuck    everything that needs a human: stuck intents,
+                                unconfirmed/ambiguous payouts, transfers needing
+                                reconciliation, compliance holds, failed swaps
+  GET /api/admin/audit/summary  counts for the dashboard badge
+"""
+import re
+from datetime import datetime, timedelta
+from typing import Any
+
+from fastapi import APIRouter, Depends, HTTPException
+
+from database import get_db
+from routes.auth import get_current_user_with_role, is_admin_role
+
+router = APIRouter(prefix="/api/admin/audit", tags=["Admin Audit"])
+
+# source key -> (collection, field used for ordering, fields never sent to the browser)
+SOURCES: dict[str, tuple[str, str, set[str]]] = {
+    "admin_actions": ("admin_audit_log", "createdAt", set()),
+    "ramp_intents": ("ramp_intents", "createdAt", set()),
+    "transfers": ("internal_transfers", "createdAt", set()),
+    "celo": ("celo_audit_log", "createdAt", set()),
+    "stellar": ("stellar_audit_log", "createdAt", set()),
+    "payouts": ("fiat_payout_audit_log", "createdAt", set()),
+    "compliance": ("compliance_checks", "created_at", {"raw_response"}),
+    # Raw bodies and request headers can contain provider secrets/PII; the
+    # parsed payload + auth verdict is what an investigation needs.
+    "callbacks": ("airtel_callback_events", "receivedAt", {"rawBody", "headers"}),
+}
+
+STUCK_INTENT_MINUTES = 5
+
+
+def _ensure_admin(current_user: dict) -> None:
+    if not is_admin_role(current_user.get("role")):
+        raise HTTPException(status_code=403, detail="Admin role required")
+
+
+def _jsonable(value: Any) -> Any:
+    """Make a Mongo document safe for JSON (ObjectId, datetime, nested)."""
+    if isinstance(value, datetime):
+        return value.isoformat() + "Z"
+    if isinstance(value, dict):
+        return {str(k): _jsonable(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple, set)):
+        return [_jsonable(v) for v in value]
+    if isinstance(value, (str, int, float, bool)) or value is None:
+        return value
+    return str(value)
+
+
+def _clean(doc: dict, hidden: set[str]) -> dict:
+    return _jsonable({k: v for k, v in doc.items() if k not in hidden})
+
+
+@router.get("/events")
+async def audit_events(
+    source: str = "admin_actions",
+    q: str | None = None,
+    limit: int = 50,
+    skip: int = 0,
+    db=Depends(get_db),
+    current_user=Depends(get_current_user_with_role),
+):
+    _ensure_admin(current_user)
+    if source not in SOURCES:
+        raise HTTPException(status_code=400, detail=f"Unknown source. Choose one of: {', '.join(SOURCES)}")
+    collection, order_field, hidden = SOURCES[source]
+    limit = max(1, min(int(limit or 50), 200))
+    skip = max(0, int(skip or 0))
+
+    query: dict = {}
+    if q:
+        # Escaped: this value is user-typed and goes into a $regex.
+        pattern = re.escape(q.strip()[:100])
+        text_fields = ["_id", "action", "event", "status", "userId", "actorEmail", "asset", "txId",
+                       "senderEmail", "recipientEmail", "trade_id", "user_id", "outcome", "path"]
+        query = {"$or": [{f: {"$regex": pattern, "$options": "i"}} for f in text_fields]}
+
+    cursor = db[collection].find(query).sort(order_field, -1).skip(skip).limit(limit)
+    docs = await cursor.to_list(length=limit)
+    total = await db[collection].count_documents(query)
+    return {
+        "status": "success", "source": source, "total": total, "skip": skip, "limit": limit,
+        "events": [_clean(d, hidden) for d in docs],
+    }
+
+
+async def _collect_stuck(db) -> dict:
+    now = datetime.utcnow()
+    stale = now - timedelta(minutes=STUCK_INTENT_MINUTES)
+    hour_ago = now - timedelta(hours=1)
+
+    async def fetch(collection: str, query: dict, order: str = "createdAt", hidden: set[str] | None = None, n: int = 100):
+        docs = await db[collection].find(query).sort(order, -1).limit(n).to_list(length=n)
+        return [_clean(d, hidden or set()) for d in docs]
+
+    return {
+        # Request began, never finished: the process died or hung after a debit.
+        "stuckIntents": await fetch("ramp_intents", {"status": "started", "createdAt": {"$lte": stale}}),
+        # Withdrawal sent to the provider with no confirmation either way.
+        "unconfirmedPayouts": await fetch(
+            "ramp_entries",
+            {"direction": "off", "status": {"$in": ["pending", "processing"]},
+             "$or": [{"needsReview": True}, {"ambiguousProvider": True}]},
+            hidden={"providerReport", "gatewayResponse", "gatewayResponseText"},
+        ),
+        # Internal transfer where the debit happened but credit/reversal didn't complete.
+        "transfersNeedingReconciliation": await fetch(
+            "internal_transfers",
+            {"$or": [{"status": "needs_reconciliation"}, {"status": "started", "createdAt": {"$lte": stale}}]},
+        ),
+        # Held for compliance and not yet released.
+        "complianceHolds": await fetch("ramp_entries", {"status": "pending_compliance_review"}),
+        # Money-moving requests that failed in the last hour (5xx = failed mid-flight).
+        "recentFailures": await fetch("ramp_intents", {"status": {"$in": ["failed", "error"]}, "createdAt": {"$gte": hour_ago}}),
+        # Callbacks that were rejected or that blew up while processing.
+        "badCallbacks": await fetch(
+            "airtel_callback_events",
+            {"receivedAt": {"$gte": hour_ago}, "$or": [{"error": {"$exists": True}}, {"processed": False}]},
+            order="receivedAt", hidden={"rawBody", "headers"}, n=50,
+        ),
+    }
+
+
+@router.get("/stuck")
+async def stuck_items(db=Depends(get_db), current_user=Depends(get_current_user_with_role)):
+    _ensure_admin(current_user)
+    data = await _collect_stuck(db)
+    return {"status": "success", "counts": {k: len(v) for k, v in data.items()}, **data}
+
+
+@router.get("/summary")
+async def audit_summary(db=Depends(get_db), current_user=Depends(get_current_user_with_role)):
+    _ensure_admin(current_user)
+    data = await _collect_stuck(db)
+    counts = {k: len(v) for k, v in data.items()}
+    return {"status": "success", "counts": counts, "needsAttention": sum(counts.values())}
