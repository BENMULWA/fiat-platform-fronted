+def assert_rate_book_fresh(rate_book: dict) -> None:
+    """Refuse to price swaps off a rate book nobody has confirmed recently.
+
+    The book is a static, admin-typed table (no market feed behind it) seeded
+    with hardcoded defaults (e.g. KES 130.50, BTC $64k). `refresh_interval_hours`
+    was only a label -- nothing ever enforced it -- so a stale or never-set book
+    kept quoting indefinitely and anyone watching the real market could trade
+    against it. Enforced when APP_ENV=production (or RATE_BOOK_ENFORCE_FRESHNESS=true):
+      * the book must have been saved by an admin at least once (updatedBy set),
+        i.e. it is not still the seeded defaults;
+      * it must be younger than RATE_BOOK_MAX_AGE_HOURS (default 2x its own
+        refresh_interval_hours).
+    """
+    enforce = (
+        os.getenv("APP_ENV", "development").strip().lower() in {"production", "prod"}
+        or os.getenv("RATE_BOOK_ENFORCE_FRESHNESS", "false").strip().lower() == "true"
+    )
+    if not enforce:
+        return
+    if not rate_book.get("updatedBy"):
+        raise HTTPException(status_code=503, detail="Swap rates have not been set by treasury yet. Trading is paused.")
+    updated_at = rate_book.get("updatedAt")
+    if not isinstance(updated_at, datetime):
+        raise HTTPException(status_code=503, detail="Swap rates have no valid timestamp. Trading is paused.")
+    refresh_hours = float(rate_book.get("refresh_interval_hours", 3) or 3)
+    max_age_hours = float(os.getenv("RATE_BOOK_MAX_AGE_HOURS") or refresh_hours * 2)
+    if datetime.utcnow() - updated_at > timedelta(hours=max_age_hours):
+        raise HTTPException(status_code=503, detail="Swap rates are out of date. Trading is paused until treasury refreshes them.")
+
